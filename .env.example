# Copy this file to .env and fill in your key. `.env` is gitignored.
#
#     copy .env.example .env
#
# The real environment wins over this file, so an already-set
# $env:OPENAI_API_KEY still takes precedence.

OPENAI_API_KEY=sk-...

# Optional - override the extraction model (default: gpt-5.6-luna).
# EXTRACT_MODEL=gpt-5.6-terra
